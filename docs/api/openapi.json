            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "deposit",
                "withdrawal",
                "opening"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "date",
                "amount"
              ],
              "default": "date"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "security": [
          {
            "atmSession": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/InertiaPage"
          },
          "302": {
            "$ref": "#/components/responses/Redirect"
          }
        }
      },
      "post": {
        "operationId": "createAtmSession",
        "tags": [
          "ATM session"
        ],
        "summary": "Karte und PIN prüfen und ATM-Sitzung starten",
        "parameters": [
          {
            "$ref": "#/components/parameters/XsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/AtmLoginInput"
              }
            }
          }
        },
        "responses": {
          "302": {
            "$ref": "#/components/responses/Redirect"
          },
          "419": {
            "$ref": "#/components/responses/CsrfFailure"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailure"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitFailure"
          }
        }
      },
      "delete": {
        "operationId": "deleteAtmSession",
        "tags": [
          "ATM session"
        ],
        "summary": "ATM-Sitzung beenden",
        "parameters": [
          {
            "$ref": "#/components/parameters/XsrfToken"
          }
        ],
        "security": [
          {
            "atmSession": []
          }
        ],
        "responses": {
          "302": {
            "$ref": "#/components/responses/Redirect"
          },
          "419": {
            "$ref": "#/components/responses/CsrfFailure"
