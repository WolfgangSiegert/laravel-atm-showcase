  "components": {
    "securitySchemes": {
      "atmSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "laravel_session",
        "description": "Von Laravel gesetztes Sitzungscookie mit gültiger Kartensitzung. Der Cookie-Name kann per Konfiguration abweichen."
      },
      "operatorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "laravel_session",
        "description": "Von Laravel gesetztes Sitzungscookie mit authentifiziertem Betreiber. Der Cookie-Name kann per Konfiguration abweichen."
      }
    },
    "parameters": {
      "XsrfToken": {
        "name": "X-XSRF-TOKEN",
        "in": "header",
        "required": true,
        "description": "URL-dekodierter Wert des zuvor gesetzten XSRF-TOKEN-Cookies",
        "schema": {
          "type": "string"
        }
      },
      "AccountId": {
        "name": "account",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "CardId": {
        "name": "card",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requestBodies": {
      "AtmStatus": {
        "required": true,
        "content": {
          "application/x-www-form-urlencoded": {
            "schema": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "maintenance"
                  ]
                }
              }
            }
          }
        }
      },
      "ResourceStatus": {
        "required": true,
        "content": {
          "application/x-www-form-urlencoded": {
            "schema": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "blocked"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "AtmLoginInput": {
        "type": "object",
        "required": [
          "card_id",
          "pin"
        ],
        "properties": {
          "card_id": {
            "type": "integer",
            "minimum": 1
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{4}$",
            "writeOnly": true
          }
        }
      },
      "DepositInput": {
        "type": "object",
        "required": [
          "amount",
          "idempotency_key"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^[0-9]{1,5}(?:[.,][0-9]{1,2})?$",
            "examples": [
              "25,50"
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "description": "Für jeden beabsichtigten Vorgang neu erzeugen; bei sicherer Wiederholung unverändert wiederverwenden."
          }
        }
      },
      "WithdrawalInput": {
        "type": "object",
        "required": [
          "withdrawal_amount",
          "idempotency_key"
        ],
        "properties": {
          "withdrawal_amount": {
            "type": "string",
            "pattern": "^[0-9]{1,4}$",
            "examples": [
              "20"
            ],
            "description": "Ganzer Eurobetrag; fachlich 10 bis 1000 Euro."
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "description": "Für jeden beabsichtigten Vorgang neu erzeugen; bei sicherer Wiederholung unverändert wiederverwenden."
          }
        }
      },
      "AdminLoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "maxLength": 255,
            "writeOnly": true
          }
        }
      },
      "CreateAccountInput": {
        "type": "object",
        "required": [
          "account_reference",
          "card_reference",
          "pin"
        ],
        "properties": {
          "customer_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "Bestehende Person; alternativ customer_name verwenden."
          },
          "customer_name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 2,
            "maxLength": 80,
            "description": "Erforderlich, wenn customer_id fehlt."
          },
          "account_reference": {
            "type": "string",
            "minLength": 4,
            "maxLength": 32,
            "pattern": "^[A-Z0-9][A-Z0-9-]*$"
          },
          "card_reference": {
            "type": "string",
            "minLength": 4,
            "maxLength": 32,
            "pattern": "^[A-Z0-9][A-Z0-9-]*$"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{4}$",
            "writeOnly": true
          }
        },
        "oneOf": [
          {
            "required": [
              "customer_id"
            ]
          },
          {
            "required": [
              "customer_name"
            ]
          }
        ]
      },
      "CreateCardInput": {
        "type": "object",
        "required": [
          "card_reference",
          "pin"
        ],
        "properties": {
          "card_reference": {
            "type": "string",
            "minLength": 4,
            "maxLength": 32,
            "pattern": "^[A-Z0-9][A-Z0-9-]*$"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{4}$",
            "writeOnly": true
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Optionales Datum nach dem heutigen Tag."
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "InertiaPage": {
        "description": "HTML-Seite oder bei korrektem Inertia-Request eine Inertia-JSON-Antwort; Props sind kein stabiler externer API-Vertrag.",
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          },
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "Redirect": {
        "description": "Browser-Redirect",
        "headers": {
          "Location": {
            "schema": {
              "type": "string",
              "format": "uri-reference"
            }
          }
        }
      },
      "ValidationFailure": {
        "description": "Validierung fehlgeschlagen. JSON wird nur bei Accept: application/json geliefert; andernfalls erfolgt ein Redirect mit Sitzungsfehlern.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "RateLimitFailure": {
        "description": "Anfragelimit überschritten"
      },
      "CsrfFailure": {
        "description": "CSRF-Token fehlt, ist ungültig oder passt nicht zur Sitzung"
      },
      "Forbidden": {
        "description": "Authentifiziert, aber ohne Superadmin-Schreibrecht"
      },
      "NotFound": {
        "description": "Ressource oder optionaler Endpoint nicht verfügbar"
      }
    }
  }
}
